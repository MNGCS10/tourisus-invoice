# Copy this to .env.local for local testing with `vercel dev`.
# In production, set these in Vercel Dashboard → Project → Settings → Environment Variables.
# NEVER commit the real values to git.

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Touris Us <invoice@yourdomain.com>"

# Supabase — project "Touris Us Invoice" (ijhcbvctyancnnmpicux)
SUPABASE_URL=https://ijhcbvctyancnnmpicux.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# Get the service_role key from: Supabase Dashboard -> Project Settings -> API
